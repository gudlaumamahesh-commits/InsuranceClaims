@model List<InsuranceClaims.Models.Entities.Claim>
@{ ViewData["Title"] = "Fraud Check"; }
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0 fw-bold"><i class="bi bi-shield-exclamation text-warning me-2"></i>Fraud Check</h2>
  <span class="badge bg-secondary fs-6">@Model.Count Claims</span>
</div>
@if (!Model.Any()) {
<div class="card"><div class="card-body text-center py-5">
  <i class="bi bi-shield-check display-4 text-success"></i>
  <p class="text-muted mt-3">All claims have been checked for fraud.</p>
</div></div>
} else {
<div class="card"><div class="table-responsive">
<table class="table table-hover mb-0">
  <thead class="table-dark"><tr><th>Claim #</th><th>Customer</th><th>Type</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
  @foreach (var c in Model) {
  <tr>
    <td><strong>#@c.ClaimId</strong></td>
    <td>@c.Customer?.Name</td>
    <td>@c.ClaimType</td>
    <td class="fw-semibold">₹@c.ClaimAmount.ToString("N0")</td>
    <td><span class="badge badge-@c.ClaimStatus.ToString()">@c.ClaimStatus.ToString().Replace("_"," ")</span></td>
    <td>
      <div class="d-flex gap-1">
        <a href="/Claim/Details/@c.ClaimId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></a>
        <a href="/Fraud/Check/@c.ClaimId" class="btn btn-warning btn-sm text-dark"><i class="bi bi-shield-exclamation me-1"></i>Run Check</a>
      </div>
    </td>
  </tr>
  }
  </tbody>
</table>
</div></div>
}