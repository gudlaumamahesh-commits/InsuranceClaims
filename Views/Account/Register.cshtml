@model InsuranceClaims.Models.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Register"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Register – InsurancePro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
    <style>
        body { background: linear-gradient(135deg,#1a1f36 0%,#4361ee 100%); min-height:100vh; display:flex; align-items:center; padding:2rem 0; }
        .card { border:none; border-radius:18px; box-shadow:0 10px 40px rgba(0,0,0,.25); }
        .toggle-pw { cursor:pointer; user-select:none; }
        .toggle-pw:hover { color:#4361ee; }
    </style>
</head>
<body>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
        <div class="text-center mb-4">
            <i class="bi bi-shield-check text-white" style="font-size:2.5rem;"></i>
            <h3 class="text-white fw-bold mt-2">InsurancePro</h3>
        </div>
        <div class="card p-4">
            <h4 class="fw-bold mb-1">Create Account</h4>
            <p class="text-muted mb-4 small">Register as a customer</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Name" class="form-control" placeholder="Virat Kohli"/>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="yourname@gmail.com"
                               oninput="this.value=this.value.toLowerCase()"/>
                    </div>
                    <div class="form-text text-muted small mb-1">
                      <i class="bi bi-info-circle me-1"></i>Must be a Gmail address (e.g., yourname@gmail.com).
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold small">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Phone" class="form-control" placeholder="9876543210"/>
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" id="regPassword" class="form-control" type="password"
                               placeholder="Min 6 chars, 1 uppercase, 1 number"/>
                        <span class="input-group-text toggle-pw" onclick="togglePassword('regPassword','regEye1')"
                              title="Show / Hide password">
                            <i class="bi bi-eye" id="regEye1"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" id="regConfirmPassword" class="form-control" type="password"
                               placeholder="Re-enter password"/>
                        <span class="input-group-text toggle-pw" onclick="togglePassword('regConfirmPassword','regEye2')"
                              title="Show / Hide password">
                            <i class="bi bi-eye" id="regEye2"></i>
                        </span>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-person-plus me-2"></i>Register
                </button>
            </form>

            <hr class="my-3"/>
            <p class="text-center text-muted small mb-0">
                Already have an account? <a href="/Account/Login" class="text-primary fw-semibold">Login here</a>
            </p>
        </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
    }
}
</script>
</body>
</html>
