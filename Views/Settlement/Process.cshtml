@model InsuranceClaims.Models.ViewModels.SettlementViewModel
@{ ViewData["Title"] = "Process Settlement"; }

<div class="mb-3">
    <a href="/Settlement/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Settlement
    </a>
</div>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header bg-success text-white py-3">
        <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Process Settlement — Claim #@Model.ClaimId</h5>
      </div>
      <div class="card-body p-4">

        @* Claim Summary *@
        <div class="card bg-light border mb-4">
          <div class="card-body py-3">
            <div class="row g-2 small">
              <div class="col-sm-6">
                <span class="text-muted">Customer</span>
                <p class="fw-bold mb-0">@(ViewBag.CustomerName ?? "—")</p>
              </div>
              <div class="col-sm-6">
                <span class="text-muted">Fraud Risk</span>
                <p class="fw-bold mb-0">@(ViewBag.FraudRisk ?? "—") (Score: @(ViewBag.FraudScore ?? "—"))</p>
              </div>
              @* Show BOTH amounts clearly *@
              <div class="col-sm-6">
                <span class="text-muted">Customer Claimed Amount</span>
                <p class="fw-bold text-primary mb-0 fs-6">₹@((ViewBag.ClaimedAmount as decimal?)?.ToString("N0") ?? "—")</p>
              </div>
              <div class="col-sm-6">
                <span class="text-muted">Surveyor Assessed Amount</span>
                <p class="fw-bold text-success mb-0 fs-6">₹@((ViewBag.AssessedAmount as decimal?)?.ToString("N0") ?? "—")</p>
                <span class="text-muted" style="font-size:.72rem;">by @(ViewBag.AssessedBy ?? "—")</span>
              </div>
            </div>
            @* @{
              decimal claimed  = (ViewBag.ClaimedAmount  as decimal?) ?? 0;
              decimal assessed = (ViewBag.AssessedAmount as decimal?) ?? 0;
              if (claimed > 0 && assessed > 0 && assessed < claimed) {
                <div class="alert alert-info py-1 small mt-2 mb-0">
                  <i class="bi bi-info-circle me-1"></i>
                  Assessed amount is <strong>₹@((claimed - assessed).ToString("N0")) less</strong> than what the customer claimed.
                  Settlement will be based on the assessed amount.
                </div>
              }
            } *@
          </div>
        </div>

        <form asp-action="Process" asp-controller="Settlement" method="post">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
          <input type="hidden" asp-for="ClaimId" />

          <div class="mb-3">
            <label asp-for="SettlementAmount" class="form-label fw-semibold">
              Settlement Amount (₹)
              <span class="text-danger">*</span>
              @* Pre-filled with assessed amount
              <span class="text-muted fw-normal small ms-2">(Pre-filled with surveyor's assessed amount)</span> *@
            </label>
            <div class="input-group input-group-lg">
              <span class="input-group-text fw-bold">₹</span>
              @* <input asp-for="SettlementAmount" class="form-control"
                     placeholder="Enter settlement amount"/> *@
                            <input asp-for="SettlementAmount" class="form-control bg-light fw-bold"
                                   readonly title="Amount is fixed to the surveyor's assessed amount" />
 
            </div>
            <div class="form-text">
              Surveyor assessed: <strong>₹@((ViewBag.AssessedAmount as decimal?)?.ToString("N0"))</strong> |
              Customer claimed: <strong>₹@((ViewBag.ClaimedAmount as decimal?)?.ToString("N0"))</strong>
            </div>
            <span asp-validation-for="SettlementAmount" class="text-danger small"></span>
          </div>

          <div class="mb-4">
            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3"
                      placeholder="Notes about this settlement (optional)..."></textarea>
          </div>

          <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
            <i class="bi bi-cash-stack me-2"></i>Process Payment
          </button>
        </form>

      </div>
    </div>
  </div>
</div>