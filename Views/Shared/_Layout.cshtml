<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – InsurancePro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
    <style>
        body{background:#f4f6fb;font-family:'Segoe UI',sans-serif;}
        .navbar-brand{font-weight:800;letter-spacing:.5px;}
        .sidebar{min-height:calc(100vh - 56px);background:#1a1f36;padding-top:1rem;}
        .sidebar .nav-link{color:#9ba4c0;padding:.55rem 1rem;border-radius:7px;margin:2px 8px;font-size:.93rem;}
        .sidebar .nav-link:hover,.sidebar .nav-link.active{background:#4361ee;color:#fff;}
        .sidebar .nav-link i{margin-right:8px;width:18px;}
        .sidebar-heading{color:#5a6080;font-size:.7rem;text-transform:uppercase;padding:.6rem 1rem .2rem;letter-spacing:1.2px;}
        .main-content{padding:1.6rem;}
        .card{border:none;box-shadow:0 1px 6px rgba(0,0,0,.07);border-radius:12px;}
        .card-header{border-radius:12px 12px 0 0!important;font-weight:600;}
        .badge-REGISTERED{background:#6c757d!important;}
        .badge-UNDER_REVIEW{background:#f59e0b!important;color:#000!important;}
        .badge-APPROVED{background:#10b981!important;}
        .badge-REJECTED{background:#ef4444!important;}
        .badge-LOW{background:#10b981!important;}
        .badge-MEDIUM{background:#f59e0b!important;color:#000!important;}
        .badge-HIGH{background:#ef4444!important;}
        .badge-PENDING{background:#f59e0b!important;color:#000!important;}
        .badge-VERIFIED{background:#10b981!important;}
        .timeline-dot{position:absolute;left:-7px;top:5px;width:11px;height:11px;background:#4361ee;border-radius:50%;}
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background:#1a1f36;">
    <div class="container-fluid">
        <a class="navbar-brand text-white" href="/"><i class="bi bi-shield-check me-2"></i>InsurancePro</a>
        <div class="ms-auto d-flex align-items-center gap-2">
            @{var role = Context.Session.GetString("UserRole"); var email = Context.Session.GetString("UserEmail");}
            @if (!string.IsNullOrEmpty(role))
            {
                <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i>@email</span>
                <span class="badge bg-primary px-2">@role</span>
                <a class="btn btn-outline-light btn-sm" href="/Account/Logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm" href="/Account/Login">Login</a>
                <a class="btn btn-primary btn-sm" href="/Account/Register">Register</a>
            }
        </div>
    </div>
</nav>

<div class="container-fluid g-0">
  <div class="row g-0">
    @if (!string.IsNullOrEmpty(role))
    {
      <div class="col-md-2 sidebar">
        <nav class="nav flex-column mt-1">
          <span class="sidebar-heading">Main</span>
          <a class="nav-link" href="/"><i class="bi bi-house-door"></i>Home</a>

          @if (role == "Customer")
          {
            <span class="sidebar-heading mt-2">Customer</span>
            <a class="nav-link" href="/Policy/MyPolicies"><i class="bi bi-file-earmark-text"></i>My Policies</a>
            <a class="nav-link" href="/Claim/MyClaims"><i class="bi bi-clipboard2-pulse"></i>My Claims</a>
            <a class="nav-link" href="/Claim/Create"><i class="bi bi-plus-circle"></i>File a Claim</a>
          }

          @if (role == "Officer")
          {
            <span class="sidebar-heading mt-2">Officer</span>
            <a class="nav-link" href="/Officer/Dashboard"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a class="nav-link" href="/Claim/AllClaims"><i class="bi bi-list-ul"></i>All Claims</a>
            <a class="nav-link" href="/Document/PendingDocuments"><i class="bi bi-file-earmark-check"></i>Pending Docs</a>
            <a class="nav-link" href="/Fraud/Index"><i class="bi bi-shield-exclamation"></i>Fraud Check</a>
          }

          @if (role == "Surveyor")
          {
            <span class="sidebar-heading mt-2">Surveyor</span>
            <a class="nav-link" href="/Assessment/Index"><i class="bi bi-clipboard-data"></i>My Assigned Claims</a>
            <a class="nav-link" href="/Document/PendingDocuments"><i class="bi bi-file-earmark-check"></i>Verify Documents</a>
          }

          @if (role == "Admin")
          {
            <span class="sidebar-heading mt-2">Admin</span>
            <a class="nav-link" href="/Admin/Index"><i class="bi bi-people"></i>Manage Users</a>
            <a class="nav-link" href="/Admin/Customers"><i class="bi bi-person-lines-fill"></i>Customers & Policies</a>
            <a class="nav-link" href="/Admin/AddPolicy"><i class="bi bi-file-earmark-plus"></i>Add Policy</a>
            <a class="nav-link" href="/Claim/AllClaims"><i class="bi bi-list-ul"></i>All Claims</a>
            <a class="nav-link" href="/Settlement/Index"><i class="bi bi-cash-coin"></i>Settlement</a>
          }
        </nav>
      </div>
      <div class="col-md-10 main-content">
        @if (TempData["Success"] != null)
        {<div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>}
        @if (TempData["Error"] != null)
        {<div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>}

        @RenderBody()
      </div>
    }
    else 
    { 
      <div class="col-12 main-content">
        @if (TempData["Success"] != null)
        {<div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>}
        @if (TempData["Error"] != null)
        {<div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>}

        @RenderBody()
      </div>
    }
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>