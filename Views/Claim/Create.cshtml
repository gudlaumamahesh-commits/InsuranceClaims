@model InsuranceClaims.Models.ViewModels.CreateClaimViewModel
@{
    ViewData["Title"] = "File a Claim";
    var eligible = ViewBag.EligiblePolicies as List<InsuranceClaims.Models.Entities.PolicyPurchase> ?? new();
    var remainingAmounts = ViewBag.RemainingAmounts as Dictionary<int, decimal> ?? new();
}
<div class="mb-3"><a href="/Claim/MyClaims" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a></div>
<div class="row justify-content-center"><div class="col-md-8">
<div class="card">
  <div class="card-header bg-primary text-white py-3"><h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>File a New Claim</h5></div>
  <div class="card-body p-4">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
      
      <div class="mb-3">
        <label asp-for="PolicyId" class="form-label fw-semibold">Select Policy <span class="text-danger">*</span></label>
        <select asp-for="PolicyId" class="form-select" id="policySelect" required onchange="updatePolicyInfo(this)">
          <option value="" data-coverage="0" data-remaining="0">-- Select an active policy --</option>
          @foreach (var p in eligible) {
            var remaining = remainingAmounts.ContainsKey(p.PolicyId) ? remainingAmounts[p.PolicyId] : (p.Policy?.CoverageAmount ?? 0);
            <option value="@p.PolicyId" data-coverage="@p.Policy?.CoverageAmount" data-remaining="@remaining">
              @p.Policy?.PolicyName — Coverage: ₹@p.Policy?.CoverageAmount.ToString("N0") | Remaining: ₹@remaining.ToString("N0") (Valid till @p.EndDate.ToString("dd MMM yyyy"))
            </option>
          }
        </select>
        <span asp-validation-for="PolicyId" class="text-danger small"></span>
        @if (!eligible.Any()) {
          <div class="alert alert-warning small mt-2 mb-0 py-2">
            <i class="bi bi-exclamation-triangle me-1"></i>
            No eligible policies found. Either you have no active policies, or all your active policies already have a pending claim.
            <a href="/" class="fw-semibold">Buy a new policy</a>
          </div>
        }
      </div>

      <div id="policyInfoCard" class="card bg-light border mb-3 d-none">
        <div class="card-body py-2 small">
          <div class="row">
            <div class="col-6">
              <span class="text-muted">Total Coverage:</span>
              <strong id="totalCoverage" class="d-block text-primary">₹0</strong>
            </div>
            <div class="col-6">
              <span class="text-muted">Remaining Claimable:</span>
              <strong id="remainingAmount" class="d-block text-success">₹0</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label asp-for="ClaimType" class="form-label fw-semibold">Claim Type <span class="text-danger">*</span></label>
        <select asp-for="ClaimType" class="form-select" required>
          <option value="">-- Select claim type --</option>
          <option>Accident</option><option>Medical Emergency</option><option>Natural Disaster</option>
          <option>Theft</option><option>Fire Damage</option><option>Vehicle Damage</option><option>Other</option>
        </select>
        <span asp-validation-for="ClaimType" class="text-danger small"></span>
      </div>

      <div class="mb-3">
        <label asp-for="ClaimAmount" class="form-label fw-semibold">Claim Amount (₹) <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text">₹</span>
          <input asp-for="ClaimAmount" class="form-control" placeholder="Enter amount" id="claimAmount" oninput="validateAmount(this)" />
        </div>
        <div id="amountError" class="text-danger small d-none">
          <i class="bi bi-exclamation-triangle-fill me-1"></i>
          Amount exceeds remaining claimable balance. Maximum allowed: <strong id="maxAllowed"></strong>
        </div>
        <span asp-validation-for="ClaimAmount" class="text-danger small"></span>
      </div>

      <hr class="my-4" />
      <h6 class="fw-bold mb-3"><i class="bi bi-bank me-2"></i>Bank Account Details</h6>

      <div class="mb-3">
        <label asp-for="BankName" class="form-label fw-semibold">Bank Name <span class="text-danger">*</span></label>
        <input asp-for="BankName" class="form-control" placeholder="e.g., State Bank of India" />
        <span asp-validation-for="BankName" class="text-danger small"></span>
      </div>

      <div class="mb-3">
        <label asp-for="BankAccountNumber" class="form-label fw-semibold">Account Number <span class="text-danger">*</span></label>
        <input asp-for="BankAccountNumber" class="form-control" placeholder="Enter 9-20 digit account number" maxlength="20" />
        <span asp-validation-for="BankAccountNumber" class="text-danger small"></span>
      </div>

      <div class="mb-4">
        <label asp-for="IFSCCode" class="form-label fw-semibold">IFSC Code <span class="text-danger">*</span></label>
        <input asp-for="IFSCCode" class="form-control" placeholder="e.g., SBIN0001234" maxlength="11" style="text-transform:uppercase" />
        <div class="form-text small">Format: 4 letters + 0 + 6 alphanumeric (e.g., SBIN0001234)</div>
        <span asp-validation-for="IFSCCode" class="text-danger small"></span>
      </div>

      <div class="alert alert-warning py-2 small mb-4">
        <i class="bi bi-exclamation-circle me-1"></i>After submitting, you <strong>must upload supporting documents</strong> to proceed.
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" id="submitBtn" @(eligible.Any() ? "" : "disabled")>
        <i class="bi bi-send me-2"></i>Submit Claim
      </button>
    </form>
  </div>
</div>
</div></div>
<script>
    var currentRemaining = 0;

    function updatePolicyInfo(sel) {
        var opt = sel.options[sel.selectedIndex];
        var coverage = parseFloat(opt.getAttribute('data-coverage')) || 0;
        currentRemaining = parseFloat(opt.getAttribute('data-remaining')) || 0;
        
        var infoCard = document.getElementById('policyInfoCard');
        if (coverage > 0) {
            document.getElementById('totalCoverage').textContent = '₹' + coverage.toLocaleString('en-IN');
            document.getElementById('remainingAmount').textContent = '₹' + currentRemaining.toLocaleString('en-IN');
            infoCard.classList.remove('d-none');
        } else {
            infoCard.classList.add('d-none');
        }
        validateAmount(document.getElementById('claimAmount'));
    }

    function validateAmount(input) {
        var amount = parseFloat(input.value) || 0;
        var errDiv = document.getElementById('amountError');
        var maxSpan = document.getElementById('maxAllowed');
        var submitBtn = document.getElementById('submitBtn');
        
        if (currentRemaining > 0 && amount > currentRemaining) {
            maxSpan.textContent = '₹' + currentRemaining.toLocaleString('en-IN');
            errDiv.classList.remove('d-none');
            input.classList.add('is-invalid');
            if (submitBtn) submitBtn.disabled = true;
        } else {
            errDiv.classList.add('d-none');
            input.classList.remove('is-invalid');
            if (submitBtn && @eligible.Any().ToString().ToLower()) submitBtn.disabled = false;
        }
    }
</script>
