@model List<InsuranceClaims.Models.Entities.Claim>
@{
    ViewData["Title"] = "All Claims";
    var role = Context.Session.GetString("UserRole");
}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0 fw-bold"><i class="bi bi-list-ul text-primary me-2"></i>All Claims</h2>
  <span class="badge bg-secondary fs-6">@Model.Count Total</span>
</div>
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
  <thead class="table-dark">
    <tr><th>ID</th><th>Customer</th><th>Policy</th><th>Type</th><th>Amount</th><th>Fraud</th><th>Status</th><th>Date</th><th>Actions</th></tr>
  </thead>
  <tbody>
  @foreach (var c in Model) {
  <tr>
    <td><strong>#@c.ClaimId</strong></td>
    <td>@c.Customer?.Name</td>
    <td><small>@c.Policy?.PolicyName</small></td>
    <td><small>@c.ClaimType</small></td>
    <td class="fw-semibold text-primary">₹@c.ClaimAmount.ToString("N0")</td>
    <td>
      @if (c.FraudCheck != null) {
        <span class="badge badge-@c.FraudCheck.RiskFlag.ToString() small">@c.FraudCheck.RiskFlag (@c.FraudCheck.FraudScore)</span>
      } else { <span class="text-muted small">—</span> }
    </td>
    <td><span class="badge badge-@c.ClaimStatus.ToString() px-2 py-1">@c.ClaimStatus.ToString().Replace("_"," ")</span></td>
    <td><small>@c.CreatedAt.ToString("dd MMM yy")</small></td>
    <td>
      <div class="d-flex gap-1 flex-wrap">
        <a href="/Claim/Details/@c.ClaimId" class="btn btn-outline-primary btn-sm" title="View"><i class="bi bi-eye"></i></a>
        @* Officer can assign surveyor to UNDER_REVIEW claims *@
        @if (role == "Officer" && c.ClaimStatus == InsuranceClaims.Enums.ClaimStatus.UNDER_REVIEW) {
          <a href="/Officer/AssignSurveyor/@c.ClaimId" class="btn btn-info btn-sm text-white" title="Assign Surveyor"><i class="bi bi-person-plus"></i></a>
        }
        @* ADMIN approves/rejects claims that have been fraud-checked *@
        @if (role == "Admin" && c.ClaimStatus == InsuranceClaims.Enums.ClaimStatus.UNDER_REVIEW && c.FraudCheck != null) {
          <form method="post" action="/Settlement/Approve" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="claimId" value="@c.ClaimId"/>
            <button type="submit" class="btn btn-success btn-sm" title="Approve" onclick="return confirm('Approve Claim #@c.ClaimId?')"><i class="bi bi-check-lg"></i></button>
          </form>
          <button class="btn btn-danger btn-sm" title="Reject" data-bs-toggle="modal" data-bs-target="#rejectModal-@c.ClaimId"><i class="bi bi-x-lg"></i></button>
        }
      </div>
    </td>
  </tr>
  }
  </tbody>
</table>
</div></div>

@foreach (var c in Model.Where(x => x.ClaimStatus == InsuranceClaims.Enums.ClaimStatus.UNDER_REVIEW && x.FraudCheck != null)) {
<div class="modal fade" id="rejectModal-@c.ClaimId" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header bg-danger text-white">
      <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Reject Claim #@c.ClaimId</h5>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>
    <form method="post" action="/Settlement/Reject">
      @Html.AntiForgeryToken()
      <div class="modal-body">
        <input type="hidden" name="claimId" value="@c.ClaimId"/>
        <p class="small text-muted mb-2"><strong>@c.Customer?.Name</strong> — ₹@c.ClaimAmount.ToString("N0")</p>
        <label class="form-label fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
        <textarea name="remarks" class="form-control" rows="3" required placeholder="Enter clear reason..."></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Confirm Reject</button>
      </div>
    </form>
  </div></div>
</div>
}