@model List<InsuranceClaims.Models.Entities.Claim>
@{
    ViewData["Title"] = "My Claims";
    var rejectedDocClaims = ViewBag.ClaimsWithRejectedDocs as HashSet<int> ?? new HashSet<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0 fw-bold"><i class="bi bi-clipboard2-pulse text-primary me-2"></i>My Claims</h2>
  <a href="/Claim/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>File New Claim</a>
</div>

@if (rejectedDocClaims.Any())
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <strong>Action Required!</strong>
        @if (rejectedDocClaims.Count == 1)
        {
            <span>One of your documents was <strong>rejected</strong> by the surveyor.</span>
        }
        else
        {
            <span>Documents in <strong>@rejectedDocClaims.Count claims</strong> were <strong>rejected</strong> by the surveyor.</span>
        }
        Please re-upload the rejected documents so your claim can proceed.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any()) {
<div class="card"><div class="card-body text-center py-5">
  <i class="bi bi-clipboard2 display-4 text-muted"></i>
  <p class="text-muted mt-3">No claims filed yet.</p>
  <a href="/Claim/Create" class="btn btn-primary">File a Claim</a>
</div></div>
} else {
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
  <thead class="table-dark">
    <tr><th>#</th><th>Policy</th><th>Type</th><th>Amount</th><th>Status</th><th>Date</th><th>Action</th></tr>
  </thead>
  <tbody>
  @foreach (var c in Model) {
    bool hasRejectedDoc = rejectedDocClaims.Contains(c.ClaimId);
  <tr class="@(hasRejectedDoc ? "table-warning" : "")">
    <td><strong>#@c.ClaimId</strong></td>
    <td>@c.Policy?.PolicyName</td>
    <td>@c.ClaimType</td>
    <td class="fw-semibold text-primary">₹@c.ClaimAmount.ToString("N0")</td>
    <td>
      <div class="d-flex flex-column gap-1">
        <span class="badge badge-@c.ClaimStatus.ToString() px-2 py-1">@c.ClaimStatus.ToString().Replace("_"," ")</span>
        @if (hasRejectedDoc) {
          <span class="badge bg-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Doc Rejected</span>
        }
      </div>
    </td>
    <td><small>@c.CreatedAt.ToString("dd MMM yyyy")</small></td>
    <td>
      <div class="d-flex gap-1 flex-wrap">
        <a href="/Claim/Details/@c.ClaimId" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-eye me-1"></i>View
        </a>
        @if (c.ClaimStatus == InsuranceClaims.Enums.ClaimStatus.REGISTERED) {
          <a href="/Document/Upload/@c.ClaimId" class="btn btn-warning btn-sm">
            <i class="bi bi-upload me-1"></i>Upload Docs
          </a>
        }
        @if (hasRejectedDoc) {
          <a href="/Document/Upload/@c.ClaimId" class="btn btn-danger btn-sm">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Re-upload
          </a>
        }
      </div>
    </td>
  </tr>
  }
  </tbody>
</table>
</div></div>
}