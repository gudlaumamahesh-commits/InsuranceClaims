@model List<InsuranceClaims.Models.Entities.ClaimDocument>
@{
    ViewData["Title"] = "Documents for Verification";
    bool isSurveyor = ViewBag.IsSurveyor ?? false;
}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0 fw-bold"><i class="bi bi-file-earmark-check text-primary me-2"></i>
    @(isSurveyor ? "My Claims — Document Verification" : "All Pending Documents")
  </h2>
  <span class="badge bg-warning text-dark fs-6">@Model.Count Pending</span>
</div>

@if (isSurveyor) {
<div class="alert alert-info small mb-4">
  <i class="bi bi-info-circle me-1"></i>
  Verify each document carefully before submitting assessment.
</div>
}

@if (!Model.Any()) {
<div class="card"><div class="card-body text-center py-5">
  <i class="bi bi-check-circle display-4 text-success"></i>
  <p class="text-muted mt-3">
    @(isSurveyor ? "No pending documents in your assigned claims." : "No pending documents. All caught up!")
  </p>
  @if (isSurveyor) {
    <a href="/Assessment/Index" class="btn btn-primary btn-sm mt-2">
      <i class="bi bi-arrow-left me-1"></i>Back to My Claims
    </a>
  }
</div></div>
} else {
@foreach (var claimGroup in Model.GroupBy(d => d.ClaimId)) {
  var firstDoc = claimGroup.First();
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
      <div>
        <strong><i class="bi bi-clipboard2 me-1 text-primary"></i>Claim #@claimGroup.Key</strong>
        <span class="text-muted small ms-2">— @firstDoc.Claim?.Customer?.Name | @firstDoc.Claim?.Policy?.PolicyName</span>
      </div>
      <span class="badge bg-warning text-dark">@claimGroup.Count() doc(s) pending</span>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr><th>Document Type</th><th>View File</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
        @foreach (var d in claimGroup) {
        <tr>
          <td><i class="bi bi-file-earmark me-2 text-muted"></i><strong>@d.DocumentName</strong></td>
          <td>
            <a href="@d.FilePath" target="_blank" class="btn btn-outline-secondary btn-sm py-0">
              <i class="bi bi-eye me-1"></i>View
            </a>
          </td>
          <td><span class="badge bg-warning text-dark">PENDING</span></td>
          <td>
            <div class="d-flex gap-2">
              <form method="post" action="/Document/Verify">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentId" value="@d.DocumentId"/>
                <input type="hidden" name="status" value="VERIFIED"/>
                <button type="submit" class="btn btn-success btn-sm">
                  <i class="bi bi-check-lg me-1"></i>Verify
                </button>
              </form>
              <form method="post" action="/Document/Verify">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentId" value="@d.DocumentId"/>
                <input type="hidden" name="status" value="REJECTED"/>
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reject this document?')">
                  <i class="bi bi-x-lg me-1"></i>Reject
                </button>
              </form>
            </div>
          </td>
        </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
}
}